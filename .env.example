# ============================================================
# Outlet Rotation App — environment variables
# Copy to .env.local for local dev and fill in real values.
# NEVER commit .env.local. This .example file holds names only.
# ============================================================

# --- Microsoft Entra ID (app registration) ---
ENTRA_TENANT_ID=
ENTRA_CLIENT_ID=
ENTRA_CLIENT_SECRET=

# OAuth redirect URI. Local: http://localhost:3000/auth/callback
# Production: https://<your-app>.azurewebsites.net/auth/callback
AZURE_REDIRECT_URI=

# --- Session signing/encryption ---
# 32+ char random string: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=
# App base URL. Local: http://localhost:3000  Production: https://<your-app>.azurewebsites.net
AUTH_URL=

# --- Authorization ---
# Comma-separated Entra security group object IDs. Empty = any tenant user allowed
# into the app itself. The Admin Center has its own separate username/password
# gate on top of this (see the AdminUsers SharePoint list) - this setting does
# NOT need to be filled in for that.
PORTAL_ALLOWED_GROUP_IDS=

# --- SharePoint (app-only, Sites.Selected) ---
# The ONLY SharePoint id the app needs. Every list is resolved by its display
# name at runtime, so list GUIDs never go in config. Get this value with:
#   GET https://graph.microsoft.com/v1.0/sites/goodwillcfl.sharepoint.com:/sites/OutletRotationApp
# and copy the "id" it returns (looks like: contoso.sharepoint.com,<guid>,<guid>).
SHAREPOINT_SITE_ID=
